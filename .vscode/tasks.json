{
    "tasks": [
        {
            "label": "C/C++: cl.exe compilar proyecto",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\scripts\\build\\build.ps1",
                "-Configuration",
                "Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PLUS_BUILD_FLAGS": "officialBuild,TRANSLATIONS_ALLOWED,VIDEOS_ALLOWED,MODS_ALLOWED"
                }
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "C/C++: cl.exe compilar core",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\scripts\\build\\build-core.ps1",
                "-Configuration",
                "Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ]
        },
        {
            "label": "Copiar build assets",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\scripts\\assets\\sync-build-assets.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PLUS_BUILD_FLAGS": "officialBuild,TRANSLATIONS_ALLOWED,VIDEOS_ALLOWED,MODS_ALLOWED"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "Copiar build assets (flags prompt)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\scripts\\assets\\sync-build-assets.ps1",
                "-Flags",
                "${input:buildFlags}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Copiar runtime plugins",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\scripts\\runtime\\copy-runtime-plugins.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Instalar dependencias vcpkg",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\scripts\\setup\\install-vcpkg-deps.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "buildFlags",
            "type": "promptString",
            "description": "Flags separadas por coma para empaquetar build/assets",
            "default": "officialBuild,TRANSLATIONS_ALLOWED,VIDEOS_ALLOWED,MODS_ALLOWED"
        }
    ],
    "version": "2.0.0"
}
