{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe compilar proyecto (core)",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/std:c++17",
                "/nologo",
                "/IC:\\vcpkg\\installed\\x64-windows\\include",
                "/Fo${workspaceFolder}\\build\\obj\\",
                "/Fd${workspaceFolder}\\build\\PlusEngine.pdb",
                "${workspaceFolder}\\source\\main.cpp",
                "${workspaceFolder}\\source\\audio\\Conductor.cpp",
                "${workspaceFolder}\\source\\audio\\MusicPlayer.cpp",
                "${workspaceFolder}\\source\\audio\\SoundPlayer.cpp",
                "${workspaceFolder}\\source\\audio\\VocalsPlayer.cpp",
                "${workspaceFolder}\\source\\core\\Application.cpp",
                "${workspaceFolder}\\source\\core\\Logger.cpp",
                "${workspaceFolder}\\source\\core\\MemoryManager.cpp",
                "${workspaceFolder}\\source\\core\\MusicBeatState.cpp",
                "${workspaceFolder}\\source\\core\\StateManager.cpp",
                "${workspaceFolder}\\source\\core\\SubStateManager.cpp",
                "${workspaceFolder}\\source\\data\\Paths.cpp",
                "${workspaceFolder}\\source\\graphics\\Alphabet.cpp",
                "${workspaceFolder}\\source\\graphics\\AnimatedSprite.cpp",
                "${workspaceFolder}\\source\\graphics\\Sprite.cpp",
                "${workspaceFolder}\\source\\graphics\\Texture.cpp",
                "${workspaceFolder}\\source\\play\\Character.cpp",
                "${workspaceFolder}\\source\\play\\HoldSplash.cpp",
                "${workspaceFolder}\\source\\play\\Note.cpp",
                "${workspaceFolder}\\source\\play\\NoteSplash.cpp",
                "${workspaceFolder}\\source\\play\\SongChart.cpp",
                "${workspaceFolder}\\source\\play\\Stage.cpp",
                "${workspaceFolder}\\source\\play\\StrumNote.cpp",
                "${workspaceFolder}\\source\\ui\\CreditsState.cpp",
                "${workspaceFolder}\\source\\ui\\FreeplayState.cpp",
                "${workspaceFolder}\\source\\ui\\LoadingState.cpp",
                "${workspaceFolder}\\source\\ui\\MainMenuState.cpp",
                "${workspaceFolder}\\source\\ui\\PlayState.cpp",
                "${workspaceFolder}\\source\\ui\\TitleState.cpp",
                "${workspaceFolder}\\source\\ui\\debug\\DebugOverlay.cpp",
                "${workspaceFolder}\\source\\ui\\transition\\FadeTransition.cpp",
                "/link",
                "/OUT:${workspaceFolder}\\build\\PlusEngine.exe",
                "/PDB:${workspaceFolder}\\build\\PlusEngine.pdb",
                "/ILK:${workspaceFolder}\\build\\PlusEngine.ilk",
                "/LIBPATH:C:\\vcpkg\\installed\\x64-windows\\lib",
                "/DELAYLOAD:SDL2.dll",
                "/DELAYLOAD:SDL2_image.dll",
                "/DELAYLOAD:SDL2_mixer.dll",
                "/DELAYLOAD:SDL2_ttf.dll",
                "SDL2.lib",
                "SDL2_image.lib",
                "SDL2_mixer.lib",
                "SDL2_ttf.lib",
                "delayimp.lib",
                "user32.lib",
                "gdi32.lib",
                "psapi.lib",
                "gdiplus.lib",
                "winmm.lib"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build"
            },
            "detail": "Tarea generada por el depurador."
        },
        {
            "label": "Copiar build assets",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\scripts\\sync-build-assets.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PLUS_BUILD_FLAGS": "officialBuild,TRANSLATIONS_ALLOWED,VIDEOS_ALLOWED,MODS_ALLOWED"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "Copiar build assets (flags prompt)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\scripts\\sync-build-assets.ps1",
                "-Flags",
                "${input:buildFlags}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Copiar runtime plugins",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\scripts\\copy-runtime-plugins.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "C/C++: cl.exe compilar proyecto",
            "dependsOrder": "sequence",
            "dependsOn": [
                "C/C++: cl.exe compilar proyecto (core)",
                "Copiar build assets",
                "Copiar runtime plugins"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ],
    "inputs": [
        {
            "id": "buildFlags",
            "type": "promptString",
            "description": "Flags separadas por coma para empaquetar build/assets",
            "default": "officialBuild,TRANSLATIONS_ALLOWED,VIDEOS_ALLOWED,MODS_ALLOWED"
        }
    ],
    "version": "2.0.0"
}